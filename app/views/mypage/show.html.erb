<%# ダーク背景 %>

<%# プロフィールヘッダー %>
<div class="pt-8 pb-6">
  <div class="flex items-center gap-4">
    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-accent-purple to-accent-pink flex items-center justify-center text-xl font-bold text-white flex-shrink-0">
      <%= @profile.name.slice(0, 1) %>
    </div>
    <div class="flex-1 min-w-0">
      <h1 class="text-lg font-bold truncate"><%= @profile.name %></h1>
    </div>
    <details class="relative shrink-0 self-start">
      <summary class="w-9 h-9 rounded-full flex items-center justify-center bg-dark-card hover:bg-accent-purple/20 cursor-pointer list-none transition-colors [&::-webkit-details-marker]:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-dark-muted">
          <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
        </svg>
      </summary>
      <div class="absolute right-0 top-11 z-10 w-48 bg-gray-700 rounded-2xl py-2 text-sm shadow-xl shadow-black/40">
        <% unless current_user.line_user? %>
          <%= link_to "アカウント設定", edit_account_path,
              class: "block px-4 py-2 hover:bg-accent-purple/10" %>
        <% end %>
        <%= link_to "利用規約", terms_path,
            class: "block px-4 py-2 hover:bg-accent-purple/10" %>
        <%= link_to "プライバシーポリシー", privacy_path,
            class: "block px-4 py-2 hover:bg-accent-purple/10" %>
        <div class="border-t border-dark-muted/20 my-2"></div>
        <%= button_to "ログアウト", destroy_user_session_path, method: :delete,
            class: "w-full text-left px-4 py-2 hover:bg-accent-purple/10 cursor-pointer text-red-400" %>
      </div>
    </details>
  </div>
</div>

<%# タブ %>
<div data-controller="tabs">
  <div class="flex border-b border-dark-border mb-6">
    <button
      class="px-4 py-3 text-sm font-medium border-b-2 border-accent-purple text-white"
      data-tabs-target="tab"
      data-tab-name="basic"
      data-action="click->tabs#switch">
      基本情報
    </button>
    <button
      class="px-4 py-3 text-sm font-medium text-dark-muted border-b-2 border-transparent"
      data-tabs-target="tab"
      data-tab-name="ai"
      data-action="click->tabs#switch">
      AI分析
    </button>
  </div>

  <%# 基本情報タブ %>
  <div data-tabs-target="panel" data-tab-name="basic">
    <section class="mb-6">
      <h2 class="text-xs text-white uppercase tracking-wider mb-3">トリセツ</h2>
      <div class="flex gap-3 overflow-x-auto pb-1 -mx-4 px-4 snap-x snap-mandatory" data-controller="carousel" data-carousel-count-value="<%= MypageController::THEMES.size + 1 %>">
        <% MypageController::THEMES.each.with_index(1) do |theme, index| %>
          <% style = theme_card_style(theme) %>
          <% manual = @manuals_by_theme[theme] %>
          <% answered_count = @answered_counts_by_theme[theme] %>
          <div class="shrink-0 snap-start" data-carousel-target="card" data-controller="card-modal">
            <button type="button"
                class="block w-[150px] h-[210px] rounded-2xl text-left"
                data-action="click->card-modal#open"
                style="<% if manual %>background: <%= style[:border_gradient] %>; padding: 2px; box-shadow: <%= style[:glow_shadow] %>;<% else %>border: 2px dashed rgba(148,163,184,0.35); padding: 0;<% end %>">
              <div class="w-full h-full rounded-[12px] p-3.5 flex flex-col" style="background: #171623;">
                <div class="flex items-center justify-between">
                  <span class="text-[9px] tracking-[0.1em] <%= manual ? "text-white" : "text-[#8f8ba8]" %>">No.<%= format("%02d", index) %></span>
                </div>
                <div class="h-px my-2" style="background: #2c2a41;"></div>

                <% if manual %>
                  <p class="text-lg font-bold bg-clip-text text-transparent" style="background-image: <%= style[:title_gradient] %>;"><%= style[:title] %></p>
                <% else %>
                  <p class="text-lg font-bold text-[#8f8ba8]"><%= style[:title] %></p>
                <% end %>
                <p class="text-[11px] mt-[5px] whitespace-nowrap overflow-hidden text-ellipsis <%= manual ? "text-white" : "text-[#8f8ba8]" %>"><%= style[:subtext] %></p>

                <div class="flex-1 flex items-start justify-center pt-2">
                  <div style="opacity: <%= manual ? "0.5" : "0.30" %>;">
                    <%= render "mypage/manual_card_icon", icon: style[:icon] %>
                  </div>
                </div>

                <div class="h-px" style="background: #2c2a41; margin: 6px 0 10px;"></div>
                <div class="text-[9px] leading-[1.6] <%= manual ? "text-white" : "text-[#8f8ba8]" %>">
                  <% if manual %>
                    <p>発行日 <%= manual.created_at.strftime("%Y.%m.%d") %></p>
                    <p>全<%= answered_count %>項目</p>
                  <% else %>
                    <p>発行日 ---</p>
                    <p>未作成</p>
                  <% end %>
                </div>
              </div>
            </button>
            <%= render "mypage/manual_card_modal", style: style, manual: manual, theme: theme %>
          </div>
        <% end %>
        <div class="shrink-0 snap-start" data-carousel-target="card">
          <div class="block w-[150px] h-[210px] rounded-2xl cursor-default" style="border: 2px dashed rgba(148,163,184,0.35); padding: 0;">
            <div class="w-full h-full rounded-[12px] p-3.5 flex flex-col" style="background: #171623;">
              <div class="flex items-center justify-between">
                <span class="text-[9px] tracking-[0.1em] text-[#8f8ba8]">No.<%= format("%02d", MypageController::THEMES.size + 1) %></span>
                <svg viewBox="0 0 48 48" fill="none" stroke="#8f8ba8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                  <rect x="13" y="21" width="22" height="18" rx="2.5" />
                  <path d="M17 21v-6a7 7 0 0 1 14 0v6" />
                </svg>
              </div>
              <div class="h-px my-2" style="background: #2c2a41;"></div>

              <p class="text-lg font-bold text-[#8f8ba8]">？？？</p>
              <p class="text-[11px] mt-[5px] whitespace-nowrap overflow-hidden text-ellipsis text-[#8f8ba8]">近日公開予定</p>

              <div class="flex-1 flex items-start justify-center pt-2">
                <div style="opacity: 0.30;">
                  <%= render "mypage/manual_card_icon", icon: :lock %>
                </div>
              </div>

              <div class="h-px" style="background: #2c2a41; margin: 6px 0 10px;"></div>
              <div class="flex justify-center">
                <span class="text-[9px] tracking-[0.1em] px-3 py-1.5 rounded-full border border-dark-muted/40 text-[#8f8ba8]">COMING SOON</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="flex justify-center gap-1.5 mt-3" data-carousel-target="dots"></div>
    </section>

    <section class="mb-6">
      <h2 class="text-xs text-white uppercase tracking-wider mb-3">プロフィール</h2>
      <div class="relative" data-controller="confirm-navigate" data-confirm-navigate-url-value="<%= edit_profile_path %>">
        <button type="button"
            class="w-full text-left bg-dark-card border border-dark-muted/20 rounded-2xl p-4 hover:border-accent-purple/40 transition-colors"
            data-action="click->confirm-navigate#open">
          <div class="flex flex-wrap gap-2">
            <span class="text-xs px-3 py-1.5 rounded-full border <%= profile_tag_style %>"><%= @profile.age %>歳</span>
            <span class="text-xs px-3 py-1.5 rounded-full border <%= profile_tag_style %>"><%= @profile.zodiac_sign %></span>
            <span class="text-xs px-3 py-1.5 rounded-full border <%= profile_tag_style %>"><%= t("enums.profile.blood_type.#{@profile.blood_type}") %></span>
            <span class="text-xs px-3 py-1.5 rounded-full border <%= profile_tag_style %>"><%= t("enums.profile.hometown.#{@profile.hometown}") %></span>
            <span class="text-xs px-3 py-1.5 rounded-full border <%= profile_tag_style %>"><%= t("enums.profile.education.#{@profile.education}") %></span>
          </div>
        </button>
        <%= render "shared/confirm_navigate_modal", message: "プロフィールを編集しますか？" %>
      </div>
    </section>

    <section class="mb-6">
      <h2 class="text-xs text-white uppercase tracking-wider mb-3">共通情報</h2>
      <% if @common_answers.any? %>
        <div class="relative" data-controller="confirm-navigate" data-confirm-navigate-url-value="<%= edit_common_answers_path %>">
          <button type="button"
              class="w-full text-left bg-dark-card border border-dark-muted/20 rounded-2xl p-4 hover:border-accent-purple/40 transition-colors"
              data-action="click->confirm-navigate#open">
            <div class="flex flex-wrap gap-2">
              <% @common_answers.each do |answer| %>
                <% label = answer.question.selection? ? answer.question_option&.label : answer.body %>
                <span class="text-xs px-3 py-1.5 rounded-full border <%= common_tag_style(answer.question.display_label) %>"><%= label %></span>
              <% end %>
            </div>
          </button>
          <%= render "shared/confirm_navigate_modal", message: "共通情報を編集しますか？" %>
        </div>
      <% else %>
        <%= link_to edit_common_answers_path, class: "block bg-dark-card border border-dark-muted/20 rounded-2xl p-4 text-sm text-dark-muted text-center" do %>
          まだ回答していません。
        <% end %>
      <% end %>
    </section>
  </div>

  <%# AI分析タブ %>
  <div data-tabs-target="panel" data-tab-name="ai" class="hidden">
    <% if @manual %>
      <section class="mb-4">
        <div class="bg-dark-card border border-dark-muted/20 rounded-2xl p-4">
          <p class="text-xs text-dark-muted mb-2">AI分析レポート</p>
          <p class="text-sm leading-relaxed whitespace-pre-line">
            <%= @manual.manual_ai_texts.find_by(section_type: :handling_guide)&.ai_text %>
          </p>
        </div>
      </section>
    <% else %>
      <div class="text-center py-12">
        <p class="text-dark-muted text-sm">基本情報タブからトリセツを作成してください。</p>
      </div>
    <% end %>
  </div>
</div>
