<% content_for :container_class, "lg:max-w-6xl" %>

<div class="pt-8 pb-4 lg:pt-0 lg:pb-6">
  <h1 class="text-xl lg:text-2xl font-bold mb-1 lg:mb-1.5">共通情報の入力</h1>
  <p class="text-sm lg:text-[15px] text-gray-400">あなたのことを教えてください。全7問です。</p>
</div>

<%# form-dirty が先にボタンの有効／無効を決め、answer-progress が未回答時のみ無効にするため、記載順を変えないこと %>
<div data-controller="form-dirty answer-progress" data-action="input->form-dirty#check input->answer-progress#update change->form-dirty#check change->answer-progress#update" class="xl:grid xl:grid-cols-[minmax(0,1fr)_280px] xl:gap-8 xl:items-start">
  <%= form_with url: common_answers_path, method: :patch, id: "common-answers-form", data: { "form-dirty-target": "form" } do %>
    <div class="space-y-6 mb-8 lg:space-y-0 lg:grid lg:grid-cols-2 lg:gap-4 xl:mb-0">
      <% @questions.each do |question| %>
        <% answer = @answers[question.id] %>
        <div id="question-<%= question.position %>" data-answer-progress-target="question" class="bg-white border-2 border-violet-500 rounded-2xl p-4 lg:p-[18px] scroll-mt-12">
          <p class="text-xs lg:text-[13px] text-gray-400 mb-1">Q<%= question.position %></p>
          <p class="font-semibold text-sm lg:text-[15px] mb-3 text-gray-900"><%= question.title %></p>

          <% if question.selection? %>
            <div class="flex flex-wrap gap-2">
              <% question.question_options.each do |option| %>
                <label class="cursor-pointer">
                  <input type="radio"
                    name="answers[<%= question.id %>][question_option_id]"
                    value="<%= option.id %>"
                    <%= answer&.question_option_id == option.id ? "checked" : "" %>
                    class="hidden peer" %>
                  <span class="inline-block px-3 py-1.5 lg:px-3.5 rounded-full text-xs lg:text-[13px] border border-gray-200 bg-white text-gray-600 peer-checked:bg-accent-purple peer-checked:text-white peer-checked:border-accent-purple transition-colors">
                    <%= option.label %>
                  </span>
                </label>
              <% end %>
            </div>
          <% else %>
            <%= text_area_tag "answers[#{question.id}][body]",
                answer&.body,
                rows: 3,
                placeholder: "入力してください",
                class: "w-full border border-gray-200 rounded-xl p-3 text-sm bg-white text-gray-900 placeholder-gray-300 outline-none focus:border-accent-purple transition-colors resize-none" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# 送信ボタンは form の外にあるため、form 属性で common-answers-form に紐付ける %>
  <aside class="lg:border lg:border-gray-200 lg:rounded-2xl lg:p-5 lg:space-y-4 xl:p-6 xl:space-y-6 xl:sticky xl:top-12">
    <%= render "manuals/answer_progress", questions: @questions %>

    <div>
      <%= submit_tag "保存してマイページへ",
          form: "common-answers-form",
          data: { "form-dirty-target": "submit", "answer-progress-target": "submit" },
          class: "w-full py-4 rounded-2xl font-bold text-white text-sm cursor-pointer bg-gradient-to-r from-accent-purple to-accent-pink hover:opacity-90 transition-opacity disabled:bg-none disabled:bg-gray-100 disabled:text-gray-400 disabled:cursor-not-allowed disabled:hover:opacity-100" %>
      <p class="hidden mt-2 text-xs text-red-500 text-center" data-answer-progress-target="warning"></p>
    </div>
  </aside>
</div>
