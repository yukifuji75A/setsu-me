<% style = theme_input_style(@theme) %>
<% content_for :container_class, "lg:max-w-6xl" %>
<%= render "manuals/step_indicator", current: 2, theme: @theme %>

<div class="pt-8 pb-4 lg:pt-0 lg:pb-6">
  <h1 class="text-xl lg:text-2xl font-bold mb-1 lg:mb-1.5">AIがトリセツを生成しました</h1>
  <p class="text-sm lg:text-[15px] text-gray-400">内容を確認して次へ進んでください。</p>
</div>

<%# PC では step3 と同じ右列（左余白16px＋幅280px）にボタンを置き、画面下端に追従させる %>
<div class="lg:grid lg:grid-cols-[minmax(0,1fr)_296px] lg:gap-4 lg:items-start">
  <div class="space-y-4 mb-8 lg:mb-0">
    <div class="bg-white border-2 <%= style[:card_border] %> rounded-2xl p-4">
      <p class="text-xs text-gray-400 mb-2">製品概要</p>
      <p class="text-sm leading-relaxed text-gray-900"><%= @basic_spec&.ai_text %></p>
    </div>
  </div>

  <div class="space-y-3 lg:ml-4 lg:self-end lg:sticky lg:bottom-8">
    <%= link_to "入力内容を確認する", step3_manuals_path(theme: @theme),
        class: "block w-full py-4 rounded-2xl font-bold text-white text-sm text-center bg-gradient-to-r #{style[:gradient]} hover:opacity-90 transition-opacity" %>
  </div>
</div>
