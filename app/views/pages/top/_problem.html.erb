<% rows = [
  { problem: "自己紹介のたびに、何を話せばいいか迷う", solution: "質問に答えるだけで、AIが文章にまとめてくれる" },
  { problem: "苦手なことを、先に伝えておきたい", solution: "「非推奨・注意事項」の章にまとめて記載" },
  { problem: "言語化して伝えることが苦手", solution: "共有URLを送れば、それだけで伝わる" }
] %>

<section id="problem" class="bg-white">
  <div class="mx-auto max-w-[1200px] px-5 lg:px-10 py-20 lg:py-28 grid lg:grid-cols-12 gap-10 lg:gap-16">
    <div class="lg:col-span-5">
      <%= render "pages/top/section_heading", number: "01", label: "こんな経験、ありませんか",
        title: "自分のことを説明するのは、意外とむずかしい。" %>
      <p class="mt-6 text-[15px] lg:text-base leading-loose text-lp-body">
        新しい環境では、初対面の人に自分の性格や価値観などを知ってもらう機会があります。知ってほしい気持ちはあっても、うまく言葉にするのは難しいものです。
      </p>
    </div>

    <div class="lg:col-span-7">
      <div class="hidden lg:grid grid-cols-2 gap-6 border-b border-lp-ink pb-3 font-plex-mono text-xs font-medium tracking-wider text-lp-sub">
        <span>症状</span>
        <span>対策</span>
      </div>
      <ul class="flex flex-col gap-4 lg:gap-0">
        <% rows.each do |row| %>
          <li class="grid lg:grid-cols-2 gap-3 lg:gap-6 rounded-2xl lg:rounded-none border lg:border-0 lg:border-b border-lp-line p-5 lg:px-0 lg:py-6">
            <p class="text-[15px] font-bold text-lp-ink">
              <span class="lg:hidden block mb-1 font-plex-mono text-[11px] font-medium text-lp-sub">症状</span>
              <%= row[:problem] %>
            </p>
            <p class="text-[15px] text-lp-body">
              <span class="lg:hidden block mb-1 font-plex-mono text-[11px] font-medium text-accent-purple">対策</span>
              <%= row[:solution] %>
            </p>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</section>
