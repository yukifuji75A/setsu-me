<%# 本物のロゴ画像ができるまでの仮ロゴ。reading: true でSPでも「セツミー」を表示する %>
<% reading = local_assigns.fetch(:reading, false) %>
<% dark = local_assigns.fetch(:dark, false) %>
<span class="flex items-center gap-2.5">
  <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-accent-purple to-accent-pink text-white font-bold flex items-center justify-center" aria-hidden="true">セ</span>
  <span class="flex flex-col leading-tight">
    <span class="font-black text-base <%= dark ? 'text-white' : 'text-lp-ink' %>">SETSU：Me</span>
    <span class="<%= reading ? 'block' : 'hidden lg:block' %> text-[11px] <%= dark ? 'text-lp-dark-muted' : 'text-lp-sub' %>">セツミー</span>
  </span>
</span>
