<div class="hidden fixed inset-0 z-50 flex items-center justify-center" data-confirm-navigate-target="modal">
  <div class="absolute inset-0 bg-black/55" data-action="click->confirm-navigate#close"></div>
  <div class="relative w-full sm:w-80 max-w-sm mx-4 bg-dark-bg border border-dark-muted/20 rounded-2xl p-5 shadow-xl">
    <p class="text-sm text-white mb-5"><%= message %></p>
    <div class="flex gap-3">
      <button type="button"
          class="flex-1 py-2.5 rounded-full text-sm font-bold text-white bg-gradient-to-r from-accent-purple to-accent-pink hover:opacity-90 transition-opacity"
          data-action="click->confirm-navigate#proceed">
        はい
      </button>
      <button type="button"
          class="flex-1 py-2.5 rounded-full text-sm font-bold text-dark-muted border border-dark-muted/30 hover:bg-white/5 transition-colors"
          data-action="click->confirm-navigate#close">
        いいえ
      </button>
    </div>
  </div>
</div>
