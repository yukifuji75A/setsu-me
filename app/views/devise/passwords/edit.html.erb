<% content_for :body_class, "bg-white text-gray-900" %>
<% content_for :card_width, "lg:max-w-md" %>
<% content_for :card_footer, render("devise/shared/legal_links") %>

<div class="flex flex-col items-center pt-2 pb-8">
  <h1 class="text-xl lg:text-2xl font-bold">パスワードの変更</h1>
</div>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="space-y-3 mb-6">
    <div>
      <p class="text-xs text-gray-400 mb-1 ml-1">
        新しいパスワード
        <% if @minimum_password_length %>
          <span class="ml-1">（<%= @minimum_password_length %>文字以上）</span>
        <% end %>
      </p>
      <div class="bg-white border-2 border-violet-500 rounded-2xl px-4 py-3 lg:py-4">
        <%= f.password_field :password,
            autofocus: true,
            autocomplete: "new-password",
            class: "w-full bg-transparent text-gray-900 placeholder-gray-300 text-sm lg:text-base outline-none" %>
      </div>
    </div>

    <div>
      <p class="text-xs text-gray-400 mb-1 ml-1">新しいパスワード（確認）</p>
      <div class="bg-white border-2 border-violet-500 rounded-2xl px-4 py-3 lg:py-4">
        <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            placeholder: "もう一度入力してください",
            class: "w-full bg-transparent text-gray-900 placeholder-gray-300 text-sm lg:text-base outline-none" %>
      </div>
    </div>
  </div>

  <%= f.submit "パスワードを変更する",
      class: "w-full py-4 rounded-2xl font-bold text-white text-sm lg:text-base cursor-pointer bg-gradient-to-r from-accent-purple to-accent-pink hover:opacity-90 transition-opacity" %>
<% end %>

<p class="text-center text-sm mt-8">
  <%= link_to "ログインへ戻る", new_user_session_path, class: "text-accent-purple hover:underline" %>
</p>
