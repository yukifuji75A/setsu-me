<% content_for :body_class, "bg-white text-gray-900" %>
<% content_for :card_width, "lg:max-w-md" %>
<% content_for :card_footer, render("devise/shared/legal_links") %>

<div class="flex flex-col items-center pt-2 pb-8">
  <h1 class="text-xl lg:text-2xl font-bold">ログイン</h1>
</div>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="space-y-3 mb-6">
    <div class="bg-white border-2 border-violet-500 rounded-2xl px-4 py-3 lg:py-4">
      <%= f.email_field :email,
          autofocus: true,
          autocomplete: "email",
          placeholder: "メールアドレス",
          class: "w-full bg-transparent text-gray-900 placeholder-gray-300 text-sm lg:text-base outline-none" %>
    </div>

    <div class="bg-white border-2 border-violet-500 rounded-2xl px-4 py-3 lg:py-4">
      <%= f.password_field :password,
          autocomplete: "current-password",
          placeholder: "パスワード",
          class: "w-full bg-transparent text-gray-900 placeholder-gray-300 text-sm lg:text-base outline-none" %>
    </div>

    <p class="text-right">
      <%= link_to "パスワードをお忘れですか？", new_user_password_path, class: "text-xs lg:text-sm text-accent-purple hover:underline" %>
    </p>
  </div>

  <%= f.submit "ログイン",
      class: "w-full py-4 rounded-2xl font-bold text-white text-sm lg:text-base cursor-pointer bg-gradient-to-r from-accent-purple to-accent-pink hover:opacity-90 transition-opacity" %>
<% end %>

<div class="flex items-center gap-3 my-6">
  <div class="flex-1 h-px bg-gray-200"></div>
  <span class="text-gray-400 text-xs">または</span>
  <div class="flex-1 h-px bg-gray-200"></div>
</div>

<%= button_to user_line_omniauth_authorize_path,
    data: { turbo: false },
    class: "w-full py-4 rounded-2xl font-bold text-white text-sm lg:text-base cursor-pointer bg-[#06C755] hover:opacity-90 transition-opacity flex items-center justify-center gap-2" do %>
  <span>LINEでログイン</span>
<% end %>

<p class="text-center text-gray-500 text-sm mt-8">
  アカウントをお持ちでない方は
  <%= link_to "新規登録", new_user_registration_path, class: "text-accent-purple hover:underline" %>
</p>

<%# PC ではカードの外（card_footer）に出す %>
<div class="lg:hidden">
  <p class="text-center text-gray-500 text-sm mt-8">
    <%= link_to "利用規約", terms_path, class: "text-accent-purple hover:underline" %>
  </p>

  <p class="text-center text-gray-500 text-sm mt-3">
    <%= link_to "プライバシーポリシー", privacy_path, class: "text-accent-purple hover:underline" %>
  </p>
</div>
