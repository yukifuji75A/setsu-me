<%# ダーク背景 %>

<div class="flex flex-col items-center pt-12 pb-8">
  <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-accent-purple to-accent-pink flex items-center justify-center mb-4">
    <span class="text-2xl">📋</span>
  </div>
  <h1 class="text-xl font-bold mb-1">アカウントを作成</h1>
  <p class="text-dark-muted text-sm">まずはアカウントを登録して、自分のトリセツを作ろう</p>
</div>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="space-y-3 mb-6">
    <div>
      <p class="text-xs text-dark-muted mb-1 ml-1">メールアドレス</p>
      <div class="bg-dark-card border border-dark-border rounded-2xl px-4 py-3">
        <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            placeholder: "example@mail.com",
            class: "w-full bg-transparent text-white placeholder-dark-muted text-sm outline-none" %>
      </div>
    </div>

    <div>
      <p class="text-xs text-dark-muted mb-1 ml-1">
        パスワード
        <% if @minimum_password_length %>
          <span class="ml-1">（<%= @minimum_password_length %>文字以上）</span>
        <% end %>
      </p>
      <div class="bg-dark-card border border-dark-border rounded-2xl px-4 py-3">
        <%= f.password_field :password,
            autocomplete: "new-password",
            placeholder: "8文字以上",
            class: "w-full bg-transparent text-white placeholder-dark-muted text-sm outline-none" %>
      </div>
    </div>

    <div>
      <p class="text-xs text-dark-muted mb-1 ml-1">パスワード（確認）</p>
      <div class="bg-dark-card border border-dark-border rounded-2xl px-4 py-3">
        <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            placeholder: "もう一度入力してください",
            class: "w-full bg-transparent text-white placeholder-dark-muted text-sm outline-none" %>
      </div>
    </div>
  </div>

  <%= f.submit "アカウントを作成する",
      class: "w-full py-4 rounded-2xl font-bold text-white text-sm cursor-pointer bg-gradient-to-r from-accent-purple to-accent-pink hover:opacity-90 transition-opacity" %>
<% end %>

<div class="flex items-center gap-3 my-6">
  <div class="flex-1 h-px bg-dark-border"></div>
  <span class="text-dark-muted text-xs">または</span>
  <div class="flex-1 h-px bg-dark-border"></div>
</div>

<%= button_to user_line_omniauth_authorize_path,
    data: { turbo: false },
    class: "w-full py-4 rounded-2xl font-bold text-white text-sm cursor-pointer bg-[#06C755] hover:opacity-90 transition-opacity flex items-center justify-center gap-2" do %>
  <span>LINEで登録</span>
<% end %>

<p class="text-center text-dark-muted text-sm mt-8">
  すでにアカウントをお持ちの方は
  <%= link_to "ログイン", new_user_session_path, class: "text-accent-purple hover:underline" %> →
</p>

<p class="text-center text-dark-muted text-sm mt-8">
  <%= link_to "利用規約", terms_path, class: "text-accent-purple hover:underline" %> 
</p>

<p class="text-center text-dark-muted text-sm mt-3">
  <%= link_to "プライバシーポリシー", privacy_path, class: "text-accent-purple hover:underline" %> 
</p>