<div class="pt-8 pb-4">
  <h1 class="text-xl font-bold mb-1">アカウント設定</h1>
  <p class="text-sm text-gray-400">メールアドレス・パスワードを変更できます</p>
</div>

<%= form_with model: @user, url: account_path, method: :patch do |f| %>
  <% if @user.errors.any? %>
    <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-2xl">
      <% @user.errors.full_messages.each do |msg| %>
        <p class="text-sm text-red-600"><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="space-y-4 mb-8">
    <div class="bg-white border-2 border-violet-500 rounded-2xl p-4">
      <p class="text-xs text-gray-400 mb-1">メールアドレス</p>
      <%= f.email_field :email,
          class: "w-full bg-transparent text-gray-900 placeholder-gray-300 text-sm outline-none" %>
    </div>

    <div class="bg-white border-2 border-violet-500 rounded-2xl p-4">
      <p class="text-xs text-gray-400 mb-1">新しいパスワード（変更する場合のみ）</p>
      <%= f.password_field :password,
          class: "w-full bg-transparent text-gray-900 placeholder-gray-300 text-sm outline-none" %>
    </div>

    <div class="bg-white border-2 border-violet-500 rounded-2xl p-4">
      <p class="text-xs text-gray-400 mb-1">新しいパスワード（確認）</p>
      <%= f.password_field :password_confirmation,
          class: "w-full bg-transparent text-gray-900 placeholder-gray-300 text-sm outline-none" %>
    </div>

    <div class="bg-white border-2 border-violet-500 rounded-2xl p-4">
      <p class="text-xs text-gray-400 mb-1">現在のパスワード（確認のため必須）</p>
      <%= f.password_field :current_password,
          class: "w-full bg-transparent text-gray-900 placeholder-gray-300 text-sm outline-none" %>
    </div>
  </div>

  <%= f.submit "更新する",
      class: "w-full py-4 rounded-2xl font-bold text-white text-sm cursor-pointer bg-gradient-to-r from-accent-purple to-accent-pink hover:opacity-90 transition-opacity" %>
<% end %>
